# Ativa a camada MSW (REST + Socket.IO). Obrigatório enquanto não houver backend real.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST feitas pelo Axios.
VITE_API_BASE_URL=/api
# Endpoint Socket.IO. Com mocks ativos, é interceptado pelo MSW (nenhuma conexão real é aberta).
VITE_SOCKET_URL=wss://realtime.nft-market.mock
# Timeout das requisições HTTP (ms).
VITE_HTTP_TIMEOUT_MS=8000
